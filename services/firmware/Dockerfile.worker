FROM betaflight/betaflight-build:arm-2026.6
ARG BETAFLIGHT_COMMIT=e0b7bb01b17b21351057e9ead2d1ab39dd44fa16
USER root
WORKDIR /source
COPY . /source
RUN test "$(git rev-parse HEAD)" = "$BETAFLIGHT_COMMIT" \
    && for submodule in src/config lib/modules/dronecan/libcanard; do \
        status="$(git submodule status -- "$submodule")"; \
        case "$status" in " "*) ;; *) echo "Required submodule is missing or mismatched: $submodule" >&2; exit 1 ;; esac; \
    done \
    && test -z "$(git -c core.autocrlf=true status --porcelain --untracked-files=all)" \
    && for repository in . src/config lib/modules/dronecan/libcanard lib/modules/dronecan/libcanard/drivers/avr/avr-can-lib; do \
        git -C "/source/$repository" -c core.autocrlf=false checkout-index --all --force; \
    done \
    && chown -R 10001:10001 /source
USER 10001:10001
WORKDIR /source
